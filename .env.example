# Không commit file .env / .env.local thật lên GitHub.
# Đây chỉ là file mẫu, chứa placeholder.
#
# Lấy 2 giá trị này ở Supabase Dashboard > Project Settings > API.
SUPABASE_URL=your_supabase_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Tên biến tương thích ngược nếu dashboard Supabase của bạn hiển thị "anon key":
# SUPABASE_ANON_KEY=your_supabase_anon_key

# KHÔNG BAO GIỜ đặt service_role / secret key ở đây hay trong bất kỳ file
# nào chạy ở trình duyệt. Secret key chỉ dùng ở server, không dùng trong CRM này.
